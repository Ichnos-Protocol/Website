# Firebase Client SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API host (Vercel rewrite target — substituted in client/vercel.json at request time
# from a build-time env-var snapshot).
#
# On Vercel: set as a single entry with Environments = "Production and Preview",
# no custom branch override. The existing staging branch override stays in place
# (branch-scoped values outrank the default).
#
#   Production                           : api.ichnos-protocol.com
#   Preview (default — main, features)   : api.ichnos-protocol.com
#   Preview / branch=staging (override)  : staging-api.ichnos-protocol.com
#
# Scopes: Vercel builds the `release` branch natively as production, so that
# build reads the PRODUCTION-scoped VITE_API_HOST. Every other preview (main,
# feature branches) reads Preview scope, and `staging` reads its Preview branch
# override. Env vars are snapshotted at build time: if Production scope is
# empty, the `release` build captures "" and /api/* returns
# `502 DNS_HOSTNAME_NOT_FOUND`. After fixing a value, redeploy with build cache
# off. See Tier 8a in docs/deploymentMigrationValidation.md and lesson E5 in
# devOpsLessonsLearned.md.
VITE_API_HOST=api.ichnos-protocol.com
