# =============================================================================
# E2E Test Credentials Template
# =============================================================================
#
# Working directory: every command in this file runs from the e2e/ directory
# (cd e2e from the repo root first).
#
# Usage:
#   1. Copy this file to .env.e2e:       cp .env.e2e.example .env.e2e
#   2. Fill in every value below except the UID fields. All of them are required.
#   3. Full provisioning: leave UID fields blank. The script creates the Firebase
#      users and writes their UIDs back into .env.e2e before syncing.
#                                         node scripts/provision-e2e-firebase-users.js
#   4. Sync-only (skip Firebase): every UID field must already be filled in.
#                                         node scripts/provision-e2e-firebase-users.js --sync-only
#
# Where the values live:
#   - e2e/.env.e2e is your LOCAL copy. It is gitignored and never committed.
#     It holds real values; this .example file holds blanks only.
#   - CI (.github/workflows/e2e.yml) never reads e2e/.env.e2e. It reads GitHub
#     repository variables and secrets, which the provision script creates from
#     your local e2e/.env.e2e:
#       variables: FIREBASE_PROJECT_ID, FIREBASE_AUTH_DOMAIN, FIREBASE_STORAGE_BUCKET,
#                  E2E_BASE_URL, E2E_API_BASE_URL, and every E2E_<ROLE>_EMAIL / _UID
#       secrets:   FIREBASE_API_KEY, E2E_SIGNUP_PASSWORD, and every E2E_<ROLE>_PASSWORD
#
# Notes:
#   - All five roles are REQUIRED. The sync refuses to run, and the e2e.yml
#     required-name gate fails, if any email, password or UID is missing.
#   - E2E_*_PASSWORD values exported in your shell take precedence over this file.
#   - UIDs are written back to this file automatically after Firebase provisioning.
#   - This script is a LOCAL/MANUAL developer/admin tool — run from your own machine,
#     not by CI or E2E workflows. ci.yml and e2e.yml consume the synced outputs only.
#   - Behavior depends on your local environment: CLI installation/PATH, gh and vercel
#     CLI auth state, server/.vercel/project.json linkage, and shell/terminal session.
#   - Troubleshooting terminal-related failures:
#       1. Confirm you are running from the e2e/ directory
#       2. gh auth status
#       3. vercel whoami
#       4. cd ../server && vercel link (must link to ichnos-protocolserver)
#

# ----- Firebase web config (REQUIRED — GitHub variables, except the API key) -----
FIREBASE_API_KEY=             # GitHub secret
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# ----- Target deployments (REQUIRED — GitHub variables) -----
E2E_BASE_URL=
E2E_API_BASE_URL=

# ----- Signup flow (REQUIRED — GitHub secret) -----
E2E_SIGNUP_PASSWORD=

# ----- Admin (REQUIRED) -----
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADMIN_UID=                # Auto-filled by provisioning script

# ----- User (REQUIRED) -----
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_USER_UID=                 # Auto-filled by provisioning script

# ----- Incomplete User (REQUIRED — used exclusively by the profile-completion E2E spec.
#       Seeded with an empty name/surname so the "Complete Your Profile" modal
#       always opens on login. Never reuse in other specs.) -----
E2E_INCOMPLETE_USER_EMAIL=
E2E_INCOMPLETE_USER_PASSWORD=
E2E_INCOMPLETE_USER_UID=      # Auto-filled by provisioning script

# ----- Super Admin (REQUIRED) -----
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=
E2E_SUPER_ADMIN_UID=          # Auto-filled by provisioning script

# ----- Manage-Admin Target (REQUIRED — mutation target for add/remove admin tests) -----
E2E_MANAGE_ADMIN_TARGET_EMAIL=
E2E_MANAGE_ADMIN_TARGET_PASSWORD=
E2E_MANAGE_ADMIN_TARGET_UID=  # Auto-filled by provisioning script
