# =============================================================================
# E2E configuration: schema reference only
# =============================================================================
#
# e2e/.env.e2e is generated whole by one command, run from the repository root:
#
#     node e2e/scripts/provision-e2e-firebase-users.js
#
# This file only documents which names the generated file contains, in the
# order it writes them. Nothing here is copied, filled in or edited, and the
# generated file is not edited by hand either: re-run the command to change it.
#
# The same run syncs these names to GitHub: 15 repository variables and 7
# repository secrets. The command also generates VERCEL_AUTOMATION_BYPASS_SECRET
# on its own and syncs it as the eighth repository secret; it is never written
# to e2e/.env.e2e. Of these names, only FIREBASE_API_KEY and the role emails
# and UIDs go to the Vercel Preview env. The run also writes the gitignored
# secrets/test-accounts.md: the local record of the test accounts and of the
# infrastructure secrets' metadata (never their values).
#
# CI (.github/workflows/e2e.yml) never reads e2e/.env.e2e. It reads the synced
# GitHub variables and secrets.
#
# Prerequisites (the only manual steps):
#   - gh auth login
#   - vercel login
#   - Firebase admin credentials for ichnos-protocol-test, from the first of:
#       --firebase-env <path>, server/.env.e2e, or a single
#       secrets/*ichnos-protocol-test*.json. server/.env is never read.
#   - VERCEL_TOKEN, only when the installed Vercel CLI lacks `vercel api`
#
# Values below are the canonical public ones where the code fixes them. Blank
# values are obtained by the command at run time.
#

# ----- Firebase web config (GitHub variables) -----
FIREBASE_PROJECT_ID=ichnos-protocol-test
FIREBASE_AUTH_DOMAIN=                  # obtained by the command from the web config
FIREBASE_STORAGE_BUCKET=               # obtained by the command from the web config

# ----- Target deployments (GitHub variables) -----
E2E_BASE_URL=https://e2e-client.ichnos-protocol.com
E2E_API_BASE_URL=https://e2e-api.ichnos-protocol.com

# ----- Role accounts (GitHub variables; emails and UIDs also go to Vercel Preview) -----
E2E_ADMIN_EMAIL=e2e-admin@ichnos-test.com
E2E_ADMIN_UID=                         # obtained by the command from Firebase
E2E_USER_EMAIL=e2e-user@ichnos-test.com
E2E_USER_UID=                          # obtained by the command from Firebase
# Incomplete user: used only by the profile-completion spec. Seeded with an
# empty name/surname so the "Complete Your Profile" modal always opens.
E2E_INCOMPLETE_USER_EMAIL=e2e-incomplete@ichnos-test.com
E2E_INCOMPLETE_USER_UID=               # obtained by the command from Firebase
E2E_SUPER_ADMIN_EMAIL=e2e-superadmin@ichnos-test.com
E2E_SUPER_ADMIN_UID=                   # obtained by the command from Firebase
# Manage-admin target: mutation target for the add/remove admin tests.
E2E_MANAGE_ADMIN_TARGET_EMAIL=e2e-manage-target@ichnos-test.com
E2E_MANAGE_ADMIN_TARGET_UID=           # obtained by the command from Firebase

# ----- Pattern passwords (GitHub secrets; test project only) -----
E2E_ADMIN_PASSWORD=adminadmin
E2E_USER_PASSWORD=useruser
E2E_INCOMPLETE_USER_PASSWORD=incomplete
E2E_SUPER_ADMIN_PASSWORD=superadmin
E2E_MANAGE_ADMIN_TARGET_PASSWORD=manage-target

# ----- Firebase web API key and signup password (GitHub secrets) -----
FIREBASE_API_KEY=                      # obtained by the command from the web config
E2E_SIGNUP_PASSWORD=signup
